% Inputs:
% Vorticity in each component represented as a pseudo-volume where the
% z-dimension is produced through the frozen flow assumption owing to the
% convection of the wake measured at the imaging plane
function [psi] = getStreamFunction(vort, L)

[Nx, Ny, Nz] = size(vort);

% REDEFINE AS BOUNDS OF WIND TUNNEL NOT BOUNDS OF FOV
L_x = L(1);
L_y = L(2);
L_z = L(3);

% Create frequency (wavenumber) vectors
kx = (2*pi/L_x) * [0:ceil(Nx/2)-1, -floor(Nx/2):-1];
ky = (2*pi/L_y) * [0:ceil(Ny/2)-1, -floor(Ny/2):-1];
kz = (2*pi/L_z) * [0:ceil(Nz/2)-1, -floor(Nz/2):-1];

% Create 3D grid of frequencies
[KX, KY, KZ] = meshgrid(kx, ky, kz);
K_squared = KX.^2 + KY.^2 + KZ.^2;
K_squared(1,1,1) = 1; % Avoid division by zero at the DC component

% x-direction
% Transform to frequency domain
f_hat = fftn(vort);

% Solve for Phi in frequency domain
psi_hat = -f_hat ./ K_squared;
psi_hat(1,1,1) = 0; % Set the mean (DC component) to zero

% Transform back to spatial domain
psi = real(ifftn(psi_hat));

end