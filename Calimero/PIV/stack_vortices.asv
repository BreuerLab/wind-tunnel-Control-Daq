function stack_vortices(x, y, vort_phase_avg, Q_phase_avg, wing_freq, num_bins, shift)
wind_speed = 4;
dt = 1 / (wing_freq * num_bins);
z = zeros(1, num_bins);
for k = 1:num_bins
    z(k) =  wind_speed * dt * k;
end

[Ny, Nx] = size(x);
Nz = length(z);

% Replicate along z
X = repmat(x, [1 1 Nz]);       % Ny x Nx x Nz
Y = repmat(y, [1 1 Nz]);       % Ny x Nx x Nz
Z = repmat(reshape(z, [1 1 Nz]), [Ny Nx 1]); % Ny x Nx x Nz

% Q_phase_avg_s = circshift(Q_phase_avg, [0 0 shift]);  % shift along the 3rd dimension (Z)
% vort_phase_avg_s = circshift(vort_phase_avg, [0 0 shift]);  % shift along the 3rd dimension (Z)

isoValue = 100;
% s = isosurface(X, Y, Z, Q_phase_avg_s, isoValue);
% cData = interp3(X, Y, Z, vort_phase_avg_s, s.vertices(:,1), s.vertices(:,2), s.vertices(:,3));
% p = patch('Vertices', s.vertices, 'Faces', s.faces, ...
%           'FaceVertexCData', cData, ...
%           'FaceColor', 'interp', ...
%           'EdgeColor', 'none');
% 
% view(3);
% params.cmin = -50;
% params.cmax = 50;
% colorbarpzn(params.cmin, params.cmax); % , 'level', 21
% xlabel("y [m]")
% ylabel("z [m]")
% zlabel("x [m]")

% choose upsampling factor
factor = 5;  % try 2 or 3

% original sizes
[Ny, Nx] = size(x);
Nz = length(z);

% Create finer grids
xq = linspace(min(x(:)), max(x(:)), Nx*factor);
yq = linspace(min(y(:)), max(y(:)), Ny*factor);
zq = linspace(min(z(:)), max(z(:)), Nz*factor);

[Xq, Yq, Zq] = meshgrid(xq, yq, zq);

% Interpolate Q and vorticity onto fine grid
Q_fine = interp3(X, Y, Z, Q_phase_avg, Xq, Yq, Zq, 'linear');
vort_fine = interp3(X, Y, Z, vort_phase_avg, Xq, Yq, Zq, 'linear');

% Q_fine = circshift(Q_fine, [0 0 shift]);  % shift along the 3rd dimension (Z)
% vort_fine = circshift(vort_fine, [0 0 shift]);  % shift along the 3rd dimension (Z)
% 
% % Now compute smoother isosurface
% s = isosurface(Xq, Yq, Zq, Q_fine, isoValue);
% 
% % Interpolate color on new vertices
% cData = interp3(Xq, Yq, Zq, vort_fine, s.vertices(:,1), s.vertices(:,2), s.vertices(:,3));
% 
% p = patch('Vertices', s.vertices, 'Faces', s.faces, ...
%           'FaceVertexCData', cData, ...
%           'FaceColor', 'interp', ...
%           'EdgeColor', 'none');

% Repeat Z coordinates
zq_big = [zq, zq + max(zq), zq + 2*max(zq)];

% Repeat data along 3rd dimension
Q_big    = cat(3, Q_fine,    Q_fine,    Q_fine);
vort_big = cat(3, vort_fine, vort_fine, vort_fine);

Q_big = circshift(Q_big, [0 0 shift]);  % shift along the 3rd dimension (Z)
vort_big = circshift(vort_big, [0 0 shift]);  % shift along the 3rd dimension (Z)

% Make a bigger grid using ndgrid
[X_big, Y_big, Z_big] = meshgrid(xq, yq, zq_big);

% Extract isosurface from larger volume
s = isosurface(X_big, Y_big, Z_big, Q_big, isoValue);

% Colors
cData = interp3(X_big, Y_big, Z_big, vort_big, ...
                s.vertices(:,1), s.vertices(:,2), s.vertices(:,3));

p = patch('vertices', s.vertices, 'faces', s.faces, ...
          'FaceVertexCData', cData, 'FaceColor', 'interp', 'EdgeColor', 'none');


view(3);
params.cmin = -100;
params.cmax = 100;
colorbarpzn(params.cmin, params.cmax); % , 'level', 21
xlabel("y [m]")
ylabel("z [m]")
zlabel("x [m]")
end