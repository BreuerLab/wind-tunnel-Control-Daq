function OF_curspeedLoop(des_freq, OF_init)
    cur_freq = checkSpeed(OF_init);
    err = abs(des_freq - cur_freq);
    OF_old = OF_init;

    while (err > 0.1)
        k = 0.01;
        OF_cur = OF_old + round(err*k,3);
        cur_freq = checkSpeed(OF_init);
        err = abs(des_freq - cur_freq);
    end
    % max resolution on OF is 20/65536 = 0.000305
end